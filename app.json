{
  "expo": {
    "name": "Défi 99",
    "slug": "sixty-six-challenge",
    "owner": "nywa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nywacmoi.defi99",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Utilisé pour ajouter des photos de progression à tes check-ins quotidiens."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/sixty-six-challenge"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisé pour ajouter des photos de progression à tes check-ins quotidiens."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "efc3bf64-a741-48f4-bb18-88dd25c91aaf"
      }
    }
  }
}
