{
  "expo": {
    "name": "Défi 99",
    "slug": "sixty-six-challenge",
    "owner": "nywa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nywacmoi.defi99",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Utilisé pour ajouter des photos de progression à tes check-ins quotidiens.",
        "NSMotionUsageDescription": "Utilisé pour afficher ton nombre de pas du jour sur les habitudes liées à la marche.",
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.nywacmoi.defi99"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#000000",
      "themeColor": "#000000"
    },
    "experiments": {
      "baseUrl": "/sixty-six-challenge"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisé pour ajouter des photos de progression à tes check-ins quotidiens."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "efc3bf64-a741-48f4-bb18-88dd25c91aaf"
      }
    }
  }
}
